# Copiar a .env en el VPS y completar. NO subir a git.

ENVIRONMENT=production
DEBUG=false
BASE_URL=https://miplantel.app

# Clave para firmar cookies (generar: openssl rand -hex 32)
SECRET_KEY=CAMBIAR

# Password del superadmin (/admin/super)
ADMIN_PASSWORD=CAMBIAR

# Password del PostgreSQL propio de Mi Plantel (docker-compose la inyecta en DATABASE_URL)
DB_PASSWORD=CAMBIAR

# WhatsApp Cloud API (Meta).
# Mientras WHATSAPP_TOKEN esté vacío, la app usa mensajería simulada (no envía nada real).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=CAMBIAR
