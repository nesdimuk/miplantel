# Database (point to Supabase self-hosted in production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assist_tracker

# App
SECRET_KEY=change-me-in-production
ENVIRONMENT=development   # development | production | test
DEBUG=false
# Public URL used inside QR codes (empty = derived from the request)
BASE_URL=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=assist_verify_token
WHATSAPP_API_VERSION=v19.0

# Admin panel password (per club in future; simple secret for MVP)
ADMIN_PASSWORD=change-me
